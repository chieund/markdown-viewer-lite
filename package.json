{
    "name": "markdown-viewer-lite",
    "displayName": "Markdown Viewer Lite (Pele)",
    "description": "Fast, lightweight Markdown preview for VS Code with TOC, search, syntax highlighting, Pele-powered Mermaid diagrams, and HTML/PDF export.",
    "version": "0.2.0",
    "publisher": "bumkom",
    "license": "MIT",
    "author": {
        "name": "Bumkom"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/chieund/markdown-viewer-lite"
    },
    "homepage": "https://github.com/chieund/markdown-viewer-lite#readme",
    "bugs": {
        "url": "https://github.com/chieund/markdown-viewer-lite/issues"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "icon": "media/icon.png",
    "galleryBanner": {
        "color": "#0B1220",
        "theme": "dark"
    },
    "categories": [
        "Visualization",
        "Other"
    ],
    "keywords": [
        "markdown",
        "markdown-preview",
        "mermaid",
        "diagram",
        "flowchart",
        "pele",
        "toc",
        "pdf-export",
        "html-export",
        "syntax-highlighting"
    ],
    "main": "./out/extension.js",
    "activationEvents": [
        "onCommand:mdpLite.openPreview",
        "onCommand:mdpLite.openFile"
    ],
    "contributes": {
        "commands": [
            {
                "command": "mdpLite.openPreview",
                "title": "Open Markdown Preview Lite",
                "category": "Markdown Lite",
                "icon": "$(open-preview)"
            },
            {
                "command": "mdpLite.openFile",
                "title": "Open Markdown File in Preview Lite",
                "category": "Markdown Lite",
                "icon": "$(book)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "mdpLite.openPreview",
                    "when": "resourceLangId == markdown",
                    "group": "navigation@1"
                }
            ],
            "editor/context": [
                {
                    "command": "mdpLite.openPreview",
                    "when": "resourceLangId == markdown",
                    "group": "navigation@1"
                }
            ],
            "explorer/context": [
                {
                    "command": "mdpLite.openFile",
                    "when": "explorerResourceIsFile",
                    "group": "navigation@90"
                }
            ]
        },
        "configuration": {
            "title": "Markdown Viewer Lite",
            "properties": {
                "markdownViewerLite.fontSize": {
                    "type": "number",
                    "default": 16,
                    "minimum": 10,
                    "maximum": 32,
                    "description": "Base font size (px) for the rendered preview."
                },
                "markdownViewerLite.theme": {
                    "type": "string",
                    "enum": [
                        "auto",
                        "light",
                        "dark"
                    ],
                    "enumDescriptions": [
                        "Follow the active VS Code color theme",
                        "Always use the light preview theme",
                        "Always use the dark preview theme"
                    ],
                    "default": "auto",
                    "description": "Preview color theme."
                },
                "markdownViewerLite.showToc": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show the table of contents sidebar when a preview opens."
                },
                "markdownViewerLite.syntaxHighlighting": {
                    "type": "boolean",
                    "default": true,
                    "description": "Highlight fenced code blocks with Prism."
                }
            }
        }
    },
    "scripts": {
        "dev": "vite",
        "build:webview": "tsc -p tsconfig.webview.json && vite build",
        "build:ext": "tsc -p ./ --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --target=node18 --external:vscode --outdir=out --entry-names=[name] --log-level=warning",
        "build": "pnpm run build:webview && pnpm run build:ext",
        "test:e2e": "pnpm run build:webview && playwright test",
        "package": "pnpm run build && vsce package --no-dependencies"
    },
    "dependencies": {
        "dompurify": "^3.3.1",
        "github-slugger": "^2.0.0",
        "pele": "^1.8.0",
        "prismjs": "^1.30.0",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-markdown": "^10.1.0",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "rehype-slug": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "unified": "^11.0.5"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.1",
        "@types/hast": "^3.0.4",
        "@types/node": "^24.10.1",
        "@types/prismjs": "^1.26.5",
        "@types/react": "^19.2.5",
        "@types/react-dom": "^19.2.3",
        "@types/vscode": "^1.85.0",
        "@vitejs/plugin-react": "^5.1.1",
        "@vscode/vsce": "^2.31.0",
        "esbuild": "^0.25.12",
        "typescript": "~5.9.3",
        "vite": "^6.0.7"
    }
}
